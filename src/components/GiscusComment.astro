<div class="giscus mt-24 text-black dark:text-white"></div>

<script>
  // Load giscus with the current theme, then keep it in sync with the toggle
  const html = document.documentElement;
  const giscusTheme = () => (html.classList.contains('dark') ? 'dark' : 'light');

  const script = document.createElement('script');
  script.src = 'https://giscus.app/client.js';
  script.async = true;
  script.crossOrigin = 'anonymous';
  script.dataset.repo = 'xeusteerapat/xeusteerapat.github.io';
  script.dataset.repoId = 'MDEwOlJlcG9zaXRvcnkyMTkyNTY4NzY=';
  script.dataset.category = 'General';
  script.dataset.categoryId = 'DIC_kwDODRGYLM4COf8-';
  script.dataset.mapping = 'title';
  script.dataset.reactionsEnabled = '1';
  script.dataset.emitMetadata = '0';
  script.dataset.inputPosition = 'bottom';
  script.dataset.theme = giscusTheme();
  script.dataset.lang = 'en';
  document.querySelector('.giscus')?.appendChild(script);

  new MutationObserver(() => {
    document
      .querySelector<HTMLIFrameElement>('iframe.giscus-frame')
      ?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: giscusTheme() } } },
        'https://giscus.app',
      );
  }).observe(html, { attributes: true, attributeFilter: ['class'] });
</script>
