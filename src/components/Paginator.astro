---
export interface Props {
  currentPage: number;
  totalPages: number;
  disablePrevious?: boolean;
  disableNext?: boolean;
}

const { currentPage, totalPages, disablePrevious, disableNext } = Astro.props;

const previousUrl = currentPage === 2 ? '/blog' : `/blog/${currentPage - 1}`;
const nextUrl = `/blog/${currentPage + 1}`;
---

{
  totalPages > 1 && (
    <nav class="mt-14 flex" aria-label="Blog pagination">
      {!disablePrevious && currentPage > 1 && (
        <a class="btn not-prose" href={previousUrl}>
          ← Prev
        </a>
      )}
      {!disableNext && currentPage < totalPages && (
        <a class="btn not-prose ml-auto" href={nextUrl}>
          Next →
        </a>
      )}
    </nav>
  )
}
