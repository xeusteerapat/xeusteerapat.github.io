---
import { SITE } from '../config';

const currentYear = new Date().getFullYear();
---

<footer
  class="mx-auto flex min-h-[4.5rem] max-w-(--w) flex-wrap items-center gap-x-6 gap-y-2 px-8 py-4 text-xs tracking-wider uppercase opacity-60"
>
  <div class="mr-auto">
    &copy; {currentYear}{' '}
    <a class="link" href={import.meta.env.BASE_URL}>{SITE.author}</a>
  </div>
  <a class="link" href="https://astro.build/" rel="noopener" target="_blank">built with astro</a>
  <a class="link" href="https://github.com/nanxiaobei/hugo-paper" rel="noopener" target="_blank">
    style: hugo-paper
  </a>
</footer>
