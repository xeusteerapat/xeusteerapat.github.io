---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIAL } from '../config';

const skills = [
	{
		title: 'Programming Languages',
		items: ['JavaScript', 'TypeScript', 'SQL', 'Python'],
	},
	{
		title: 'Frontend',
		items: ['React.js', 'Redux', 'Next.js', 'CSS/SCSS/Tailwind'],
	},
	{
		title: 'Backend',
		items: [
			'Node.js',
			'Express.js',
			'GraphQL',
			'NoSQL: MongoDB, Redis',
			'PostgreSQL, MySQL',
		],
	},
	{
		title: 'DevOps & Cloud',
		items: [
			'AWS Web Services',
			'Google Cloud',
			'Docker',
			'Kubernetes',
			'CI/CD pipelines',
			'Git/GitHub',
		],
	},
];
---

<BaseLayout title='About Me | Hello, World' description='About Teerapat Prommarak'>
	<article>
		<header class='mb-14'>
			<h1 class='my-0! pb-2.5'>About Me</h1>
		</header>

		<section>
			<div class='not-prose mb-12 flex items-center'>
				<div
					class='mr-5 -ml-1 h-24 w-24 shrink-0 rounded-full border-[0.5px] border-black/10 bg-white/50 p-3 dark:bg-white/90'
				>
					<img
						class='h-full w-full rounded-full bg-black/5 object-cover hover:animate-spin dark:bg-black/80'
						src='/images/profile_photo.jpg'
						alt={SITE.author}
					/>
				</div>
				<div>
					<div class='mb-1 text-2xl font-medium'>{SITE.author}</div>
					<div>Full-stack Web Developer 👨‍💻</div>
				</div>
			</div>

			<h2>My Journey</h2>
			<p>
				I'm passionate about web development and creating efficient,
				user-friendly applications. My journey began with a different career
				path, but my curiosity and love for coding led me to software
				engineering.
			</p>

			<h2>Technical Skills</h2>
			<div class='grid grid-cols-1 gap-x-10 gap-y-10 md:grid-cols-2'>
				{
					skills.map((category) => (
						<div>
							<h3 class='mt-0!'>{category.title}</h3>
							<ul>
								{category.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
					))
				}
			</div>

			<h2>Connect With Me</h2>
			<ul>
				{
					SOCIAL.map((item) => (
						<li>
							<a href={item.href} target='_blank' rel='noopener noreferrer'>
								{item.name}
							</a>
						</li>
					))
				}
			</ul>

			<p class='mt-12'>
				<a
					class='btn not-prose'
					href='https://teerapat-prommarak-resume.netlify.app/'
					target='_blank'
					rel='noopener noreferrer'
				>
					View My Resume
				</a>
			</p>
		</section>
	</article>
</BaseLayout>
