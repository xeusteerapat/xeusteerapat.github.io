---
import BlogPost from '../../layouts/BlogPost.astro';
import { getPosts, getSlug } from '../../lib/posts';

type PostLink = { title: string; href: string };

type ParamsProps = {
	params: { slug: string };
	props: { post: any; older?: PostLink; newer?: PostLink };
};

export async function getStaticPaths(): Promise<ParamsProps[]> {
	const posts = Object.values(
		import.meta.glob('../../posts/**/*.md', { eager: true }),
	);

	// Published posts, newest first, used to find each post's neighbours
	const published = getPosts();
	const toLink = (p?: (typeof published)[number]): PostLink | undefined =>
		p && { title: p.frontmatter.title, href: `/blog/${getSlug(p)}` };

	return posts.map((post) => {
		// Extract post slug from file path
		// Format: /Users/.../src/posts/2019-11-03/first-post.md -> first-post
		const pathParts = post.file.split('/');
		const fileName = pathParts[pathParts.length - 1];
		const slug = fileName.replace('.md', '');

		// Process image paths to make them relative to post directory
		const content = post.compiledContent();
		const updatedPost = {
			...post,
			// Add metadata about the post directory to use for image resolution
			postDirectory: pathParts.slice(-2)[0],
		};

		const index = published.findIndex((p) => getSlug(p) === slug);

		return {
			params: { slug },
			props: {
				post: updatedPost,
				older: index === -1 ? undefined : toLink(published[index + 1]),
				newer: index === -1 ? undefined : toLink(published[index - 1]),
			},
		};
	});
}

const { post, older, newer } = Astro.props;
const { Content } = post;
---

<BlogPost content={post.frontmatter} older={older} newer={newer}>
	<Content />
</BlogPost>
