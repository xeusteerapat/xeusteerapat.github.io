---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import { formatDate, getPosts, getSlug } from '../lib/posts';

const latestPosts = getPosts().slice(0, SITE.postsPerPage);
---

<BaseLayout title={SITE.title} description={SITE.description}>
	<div class="-mt-2 mb-12 flex items-center">
		<div
			class="mr-5 -ml-1 h-24 w-24 shrink-0 rounded-full border-[0.5px] border-black/10 bg-white/50 p-3 dark:bg-white/90!"
		>
			<img
				class="not-prose my-0 h-full w-full rounded-full bg-black/5! object-cover hover:animate-spin dark:bg-black/80!"
				src="/images/profile_photo.jpg"
				alt={SITE.author}
			/>
		</div>
		<div>
			<div class="mt-3 mb-1 text-2xl font-medium text-black dark:text-white">
				{SITE.author}
			</div>
			<div class="break-words">{SITE.description}</div>
		</div>
	</div>

	{
		latestPosts.map((post) => (
			<section class="relative my-10 first-of-type:mt-0 last-of-type:mb-0">
				<h2 class="my-0!">{post.frontmatter.title}</h2>
				<time class="text-xs antialiased opacity-60">
					{formatDate(post.frontmatter.date)}
				</time>
				<a class="absolute inset-0 text-[0px]" href={`/blog/${getSlug(post)}`}>
					{post.frontmatter.title}
				</a>
			</section>
		))
	}

	<nav class="mt-14 flex">
		<a class="btn not-prose ml-auto" href="/blog">All posts →</a>
	</nav>
</BaseLayout>
