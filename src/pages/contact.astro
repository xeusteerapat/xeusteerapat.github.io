---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIAL } from '../config';

const links = [
	...SOCIAL,
	{ name: 'Facebook', href: 'https://www.facebook.com/curiousdevxeus' },
];
---

<BaseLayout title='Contact | Hello, World' description='Contact Teerapat Prommarak'>
	<article>
		<header class='mb-14'>
			<h1 class='my-0! pb-2.5'>Contact Me</h1>
		</header>

		<section>
			<p>
				I'd love to hear from you! Whether you have a question, project idea, or
				just want to connect, please feel free to reach out through any of the
				channels below.
			</p>

			<h2>Get in Touch</h2>
			<ul>
				<li>
					Email: <a href='mailto:xeus085@gmail.com'>xeus085@gmail.com</a>
				</li>
				<li>Location: Bangkok, Thailand</li>
			</ul>

			<h2>Social Media</h2>
			<ul>
				{
					links.map((item) => (
						<li>
							<a href={item.href} target='_blank' rel='noopener noreferrer'>
								{item.name}
							</a>
						</li>
					))
				}
			</ul>

			<h2>My Resume</h2>
			<p>
				Want to learn more about my experience and background? Check out my
				resume for a detailed overview of my skills and professional history.
			</p>
			<p class='mt-12'>
				<a
					class='btn not-prose'
					href='https://teerapat-prommarak-resume.netlify.app/'
					target='_blank'
					rel='noopener noreferrer'
				>
					View My Resume
				</a>
			</p>
		</section>
	</article>
</BaseLayout>
